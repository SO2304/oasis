WorldInfo {
  info [
    "OASIS Swarm: 3 Crazyflie drones with federated learning"
  ]
  title "OASIS Swarm"
}
Viewpoint {
  orientation -0.3 0.6 0.7 0.9
  position -2.5 -2.5 2.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 4 4
}
Solid {
  translation 0.6 0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 1.0 0.2 0.2 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "pillar_danger"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation -0.6 0.6 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 1.0 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "pillar_blue"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation 0 -0.6 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.2 1.0 0.2 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "pillar_green"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Crazyflie {
  translation 0 0 0.015
  name "drone_alpha"
  controller "oasis_swarm"
  controllerArgs ["alpha" "0"]
}
Crazyflie {
  translation -0.8 0 0.015
  name "drone_beta"
  controller "oasis_swarm"
  controllerArgs ["beta" "1"]
}
Crazyflie {
  translation 0 -0.8 0.015
  name "drone_gamma"
  controller "oasis_swarm"
  controllerArgs ["gamma" "2"]
}
