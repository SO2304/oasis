#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/bitcraze/crazyflie/protos/Crazyflie.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  info [
    "OASIS Recon-10 v5: 3 stimulus mechanisms for habituation test."
    "10 recon drones (stratified 4 layers) + 2 hazard drones orbiting during EXTREME phases."
    "Fault injection (sonar_alive=false) on 3 drones during first 8s of each EXTREME phase."
    "phone_brain loaded at startup (128 pain memories + federation digest)."
  ]
  title "OASIS Recon-10 v5"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.25 0.4 0.88 1.1
  position -7 -7 6
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 12 10
  appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 0.8 }
}
# Perimeter walls (12x10)
Solid { translation 0 5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 12 0.1 2.0 } } ] name "wall_n" boundingObject Box { size 12 0.1 2.0 } }
Solid { translation 0 -5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 12 0.1 2.0 } } ] name "wall_s" boundingObject Box { size 12 0.1 2.0 } }
Solid { translation 6 0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 10 2.0 } } ] name "wall_e" boundingObject Box { size 0.1 10 2.0 } }
Solid { translation -6 0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 10 2.0 } } ] name "wall_w" boundingObject Box { size 0.1 10 2.0 } }
# Factory machines (match OBSTACLES[])
Solid { translation -1.5 1.0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.3 0.3 0.8 } geometry Box { size 1.2 0.8 1.5 } } ] name "cnc_machine" boundingObject Box { size 1.2 0.8 1.5 } }
Solid { translation 0.5 0 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.8 0.3 0.1 } geometry Box { size 0.6 0.6 1.0 } } ] name "press" boundingObject Box { size 0.6 0.6 1.0 } }
Solid { translation 1.8 -1.0 0.6 children [ Shape { appearance PBRAppearance { baseColor 0.9 0.9 0.1 } geometry Cylinder { height 1.2 radius 0.3 } } ] name "welder" boundingObject Cylinder { height 1.2 radius 0.3 } }
Solid { translation 1.5 1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.8 0.2 } geometry Box { size 0.5 0.5 1.0 } } ] name "assembly" boundingObject Box { size 0.5 0.5 1.0 } }
Solid { translation 0 -1.5 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 } geometry Box { size 3.0 0.3 0.5 } } ] name "conveyor" boundingObject Box { size 3.0 0.3 0.5 } }
Solid { translation -2.0 -0.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.6 0.4 0.2 } geometry Box { size 0.4 1.5 2.0 } } ] name "rack1" boundingObject Box { size 0.4 1.5 2.0 } }
Solid { translation 2.2 0.8 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.6 0.4 0.2 } geometry Box { size 0.4 1.5 2.0 } } ] name "rack2" boundingObject Box { size 0.4 1.5 2.0 } }
Solid { translation -1.0 -1.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.7 } geometry Cylinder { height 2.0 radius 0.1 } } ] name "pillar1" boundingObject Cylinder { height 2.0 radius 0.1 } }
Solid { translation 1.0 1.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.7 } geometry Cylinder { height 2.0 radius 0.1 } } ] name "pillar2" boundingObject Cylinder { height 2.0 radius 0.1 } }
# 10 recon drones (same layout as v2)
Crazyflie { translation -4.0 -3.5 0.015 name "d00" controller "oasis_recon_10_v5" controllerArgs ["d00" "0" "1.00" "cnc,rack1"] }
Crazyflie { translation  0.0 -3.5 0.015 name "d01" controller "oasis_recon_10_v5" controllerArgs ["d01" "1" "1.00" "press,welder"] }
Crazyflie { translation  4.0 -3.5 0.015 name "d02" controller "oasis_recon_10_v5" controllerArgs ["d02" "2" "1.00" "assembly,rack2"] }
Crazyflie { translation -4.0  3.5 0.015 name "d03" controller "oasis_recon_10_v5" controllerArgs ["d03" "3" "1.30" "conv_w,cnc"] }
Crazyflie { translation  0.0  3.5 0.015 name "d04" controller "oasis_recon_10_v5" controllerArgs ["d04" "4" "1.30" "conv_e,press"] }
Crazyflie { translation  4.0  3.5 0.015 name "d05" controller "oasis_recon_10_v5" controllerArgs ["d05" "5" "1.30" "welder,rack1"] }
Crazyflie { translation -4.3  0.0 0.015 name "d06" controller "oasis_recon_10_v5" controllerArgs ["d06" "6" "1.70" "assembly,rack2"] }
Crazyflie { translation  4.3  0.0 0.015 name "d07" controller "oasis_recon_10_v5" controllerArgs ["d07" "7" "1.70" "conv_w,welder"] }
Crazyflie { translation -2.0  0.0 0.015 name "d08" controller "oasis_recon_10_v5" controllerArgs ["d08" "8" "2.00" "cnc,assembly,conv_e"] }
Crazyflie { translation  2.0  0.0 0.015 name "d09" controller "oasis_recon_10_v5" controllerArgs ["d09" "9" "2.00" "rack1,rack2,press"] }
# 2 hazard drones — orbit the center during EXTREME phases at alt 1.5m
Crazyflie { translation  3.0  2.5 0.015 name "hz0" controller "hazard_drone_v5" controllerArgs ["hz0" "0"] }
Crazyflie { translation -3.0 -2.5 0.015 name "hz1" controller "hazard_drone_v5" controllerArgs ["hz1" "1"] }
