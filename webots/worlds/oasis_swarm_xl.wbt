#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/bitcraze/crazyflie/protos/Crazyflie.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  info [
    "OASIS Swarm XL: 5 drones, wind, 8 obstacles, large arena"
  ]
  title "OASIS Swarm XL"
}
Viewpoint {
  orientation -0.25 0.5 0.8 1.0
  position -4.0 -4.0 4.0
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 6 6
}
# 8 pillars scattered across the arena (2m tall, can't fly over)
Solid {
  translation 0.7 0.3 1.0
  children [ Shape { appearance PBRAppearance { baseColor 1.0 0.2 0.0 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p1"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation -0.5 0.7 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.0 0.3 1.0 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p2"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation -0.8 -0.3 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.0 1.0 0.3 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p3"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation 0.3 -0.8 1.0
  children [ Shape { appearance PBRAppearance { baseColor 1.0 1.0 0.0 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p4"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation 1.0 -0.5 1.0
  children [ Shape { appearance PBRAppearance { baseColor 1.0 0.0 1.0 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p5"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation -0.2 0.0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p6_center"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation 0.5 1.0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.8 0.4 0.0 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p7"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
Solid {
  translation -1.0 0.0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.0 0.8 0.8 } geometry Cylinder { height 2.0 radius 0.08 } } ]
  name "p8"
  boundingObject Cylinder { height 2.0 radius 0.08 }
}
# Walls
Solid {
  translation 1.5 0 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.7 0.2 0.2 } geometry Box { size 0.1 3.0 1.0 } } ]
  name "wall_e"
  boundingObject Box { size 0.1 3.0 1.0 }
}
Solid {
  translation -1.5 0 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.7 } geometry Box { size 0.1 3.0 1.0 } } ]
  name "wall_w"
  boundingObject Box { size 0.1 3.0 1.0 }
}
Solid {
  translation 0 1.5 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.2 0.7 0.2 } geometry Box { size 3.0 0.1 1.0 } } ]
  name "wall_n"
  boundingObject Box { size 3.0 0.1 1.0 }
}
Solid {
  translation 0 -1.5 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.2 } geometry Box { size 3.0 0.1 1.0 } } ]
  name "wall_s"
  boundingObject Box { size 3.0 0.1 1.0 }
}
# 5 Drones — spread across the arena
Crazyflie {
  translation 0 0 0.015
  name "drone_alpha"
  controller "oasis_swarm_xl"
  controllerArgs ["alpha" "0"]
}
Crazyflie {
  translation -1.0 0.5 0.015
  name "drone_beta"
  controller "oasis_swarm_xl"
  controllerArgs ["beta" "1"]
}
Crazyflie {
  translation 0.5 -1.0 0.015
  name "drone_gamma"
  controller "oasis_swarm_xl"
  controllerArgs ["gamma" "2"]
}
Crazyflie {
  translation 1.0 0.8 0.015
  name "drone_delta"
  controller "oasis_swarm_xl"
  controllerArgs ["delta" "3"]
}
Crazyflie {
  translation -0.5 -0.8 0.015
  name "drone_epsilon"
  controller "oasis_swarm_xl"
  controllerArgs ["epsilon" "4"]
}
