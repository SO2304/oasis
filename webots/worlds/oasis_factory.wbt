#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/bitcraze/crazyflie/protos/Crazyflie.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  info [
    "OASIS Factory Inspection: 2 patrol drones + 1 supervisor"
    "Machines, conveyors, restricted zones, emergency stops"
  ]
  title "OASIS Factory"
}
Viewpoint {
  orientation -0.25 0.4 0.88 1.1
  position -5 -5 5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 8 6
  appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 0.8 }
}
# Factory walls
Solid {
  translation 0 2.5 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 7.0 0.1 2.0 } } ]
  name "wall_n"
  boundingObject Box { size 7.0 0.1 2.0 }
}
Solid {
  translation 0 -2.5 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 7.0 0.1 2.0 } } ]
  name "wall_s"
  boundingObject Box { size 7.0 0.1 2.0 }
}
Solid {
  translation 3.0 0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 5.0 2.0 } } ]
  name "wall_e"
  boundingObject Box { size 0.1 5.0 2.0 }
}
Solid {
  translation -3.0 0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 5.0 2.0 } } ]
  name "wall_w"
  boundingObject Box { size 0.1 5.0 2.0 }
}
# Machine 1: CNC (large, left side)
Solid {
  translation -1.5 1.0 0.75
  children [ Shape { appearance PBRAppearance { baseColor 0.3 0.3 0.8 } geometry Box { size 1.2 0.8 1.5 } } ]
  name "cnc_machine"
  boundingObject Box { size 1.2 0.8 1.5 }
}
# Machine 2: Press (center)
Solid {
  translation 0.5 0 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.8 0.3 0.1 } geometry Box { size 0.6 0.6 1.0 } } ]
  name "press"
  boundingObject Box { size 0.6 0.6 1.0 }
}
# Machine 3: Welding station (right)
Solid {
  translation 1.8 -1.0 0.6
  children [ Shape { appearance PBRAppearance { baseColor 0.9 0.9 0.1 } geometry Cylinder { height 1.2 radius 0.3 } } ]
  name "welder"
  boundingObject Cylinder { height 1.2 radius 0.3 }
}
# Machine 4: Assembly robot (right-rear)
Solid {
  translation 1.5 1.5 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.2 0.8 0.2 } geometry Box { size 0.5 0.5 1.0 } } ]
  name "assembly"
  boundingObject Box { size 0.5 0.5 1.0 }
}
# Conveyor belt (long, center-south)
Solid {
  translation 0 -1.5 0.25
  children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 } geometry Box { size 3.0 0.3 0.5 } } ]
  name "conveyor"
  boundingObject Box { size 3.0 0.3 0.5 }
}
# Storage racks (back wall)
Solid {
  translation -2.0 -0.5 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.6 0.4 0.2 } geometry Box { size 0.4 1.5 2.0 } } ]
  name "rack1"
  boundingObject Box { size 0.4 1.5 2.0 }
}
Solid {
  translation 2.2 0.8 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.6 0.4 0.2 } geometry Box { size 0.4 1.5 2.0 } } ]
  name "rack2"
  boundingObject Box { size 0.4 1.5 2.0 }
}
# Pillars (structural)
Solid {
  translation -1.0 -1.0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.7 } geometry Cylinder { height 2.0 radius 0.1 } } ]
  name "pillar1"
  boundingObject Cylinder { height 2.0 radius 0.1 }
}
Solid {
  translation 1.0 1.0 1.0
  children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.7 } geometry Cylinder { height 2.0 radius 0.1 } } ]
  name "pillar2"
  boundingObject Cylinder { height 2.0 radius 0.1 }
}
# Patrol Drone 1: inspects left side
Crazyflie {
  translation -2.0 -2.0 0.015
  name "patrol_1"
  controller "oasis_factory"
  controllerArgs ["patrol1" "0"]
}
# Patrol Drone 2: inspects right side
Crazyflie {
  translation 2.0 -2.0 0.015
  name "patrol_2"
  controller "oasis_factory"
  controllerArgs ["patrol2" "1"]
}
# Supervisor Drone: high altitude overview
Crazyflie {
  translation 0 0 0.015
  name "supervisor"
  controller "oasis_factory"
  controllerArgs ["supervisor" "2"]
}
