#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/bitcraze/crazyflie/protos/Crazyflie.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  info [
    "OASIS Recon-20: 20 drones, 50 km virtual reconnaissance + RTH, alternating extreme/calm conditions"
    "Virtual distance scale: 1 actual meter = 10 virtual meters (documented)"
    "Habituation test: fear response should diminish across repeated extreme cycles"
  ]
  title "OASIS Recon-20 — 50 km Mission"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.25 0.5 0.8 1.0
  position -10.0 -10.0 8.0
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 12 12
}
# 12 obstacles scattered across the larger arena
Solid { translation  2.0  1.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 1.0 0.2 0.0 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p01" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation -1.5  2.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.0 0.3 1.0 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p02" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation -2.5 -0.8 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.0 1.0 0.3 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p03" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation  1.0 -2.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 1.0 1.0 0.0 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p04" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation  3.0 -1.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 1.0 0.0 1.0 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p05" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation -0.5  0.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p06" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation  1.5  3.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.8 0.4 0.0 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p07" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation -3.0  0.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.0 0.8 0.8 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p08" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation  0.5  2.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.6 0.0 0.6 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p09" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation -2.0 -2.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.3 0.6 0.0 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p10" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation  2.5  2.5 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.9 0.9 0.1 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p11" boundingObject Cylinder { height 2.0 radius 0.10 } }
Solid { translation -3.0 -3.0 1.0 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.6 } geometry Cylinder { height 2.0 radius 0.10 } } ] name "p12" boundingObject Cylinder { height 2.0 radius 0.10 } }
# 4 perimeter walls (12m arena, walls at +/- 5.5m)
Solid { translation  5.5 0 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.7 0.2 0.2 } geometry Box { size 0.1 11.0 1.0 } } ] name "wall_e" boundingObject Box { size 0.1 11.0 1.0 } }
Solid { translation -5.5 0 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.7 } geometry Box { size 0.1 11.0 1.0 } } ] name "wall_w" boundingObject Box { size 0.1 11.0 1.0 } }
Solid { translation 0  5.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.7 0.2 } geometry Box { size 11.0 0.1 1.0 } } ] name "wall_n" boundingObject Box { size 11.0 0.1 1.0 } }
Solid { translation 0 -5.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.2 } geometry Box { size 11.0 0.1 1.0 } } ] name "wall_s" boundingObject Box { size 11.0 0.1 1.0 } }
# 20 Drones — 5 columns x 4 rows grid, spaced 1.6m apart, centered around origin
# Row 0 (y = -3.6)
Crazyflie { translation -3.2 -3.6 0.015 name "drone_d00" controller "oasis_recon_20" controllerArgs ["d00" "0"] }
