[0:v]drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='OASIS':fontsize=120:fontcolor=#00ff88:x=(w-text_w)/2:y=200,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='Devices that communicate, adapt and survive':fontsize=48:fontcolor=white:x=(w-text_w)/2:y=400,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='sensor loss — without any server or infrastructure':fontsize=48:fontcolor=white:x=(w-text_w)/2:y=480,drawtext=fontfile='C\:/Windows/Fonts/arial.ttf':text='Use case\: BVLOS drone inspection (wind turbine, gas pipeline)':fontsize=34:fontcolor=#aaaaaa:x=(w-text_w)/2:y=620,drawtext=fontfile='C\:/Windows/Fonts/arial.ttf':text='When GPS RAIM degrades 8 km from last relay, what happens?':fontsize=34:fontcolor=#aaaaaa:x=(w-text_w)/2:y=690,fade=in:0:8,fade=out:st=8:d=1[intro];[1:v]fade=in:0:6,fade=out:st=14:d=1[arch];[2:v]drawbox=x=15:y=200:w=510:h=60:color=red@0.85:t=5:enable='between(t,3,8)+between(t,15,20)+between(t,22,27)',drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='SPORE received (phone live)':fontsize=28:fontcolor=red:box=1:boxcolor=black@0.7:boxborderw=8:x=15:y=150:enable='between(t,3,8)+between(t,15,20)+between(t,22,27)',drawbox=x=560:y=400:w=1340:h=50:color=red@0.85:t=5:enable='between(t,9,14)+between(t,17,22)+between(t,28,30)',drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='MESH merged from phone (drone)':fontsize=28:fontcolor=red:box=1:boxcolor=black@0.7:boxborderw=8:x=565:y=355:enable='between(t,9,14)+between(t,17,22)+between(t,28,30)',drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='LIVE PROOF — bidirectional digest exchange':fontsize=36:fontcolor=#00ff88:box=1:boxcolor=black@0.7:boxborderw=12:x=(w-text_w)/2:y=20[seg2];[3:v]fade=in:0:6,fade=out:st=18:d=2[graph];[4:v]drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='Empirical evidence':fontsize=64:fontcolor=#00ff88:x=(w-text_w)/2:y=110,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='5 OASIS kernels   |   3 hardware platforms   |   479 cross-platform events':fontsize=34:fontcolor=white:x=(w-text_w)/2:y=270,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='Phone -> Webots\:  78 MESH merged in 5 min':fontsize=36:fontcolor=#cccccc:x=(w-text_w)/2:y=380,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='Phone <- mesh    \:  401 SPORE received in 5 min':fontsize=36:fontcolor=#cccccc:x=(w-text_w)/2:y=450,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='Vitality (R14)\: 205 005 actuation gating events on 28h+ phone session':fontsize=32:fontcolor=#cccccc:x=(w-text_w)/2:y=550,drawtext=fontfile='C\:/Windows/Fonts/arial.ttf':text='Graceful sensor degradation. No cloud. No broker. No schema agreement.':fontsize=30:fontcolor=#888888:x=(w-text_w)/2:y=680,drawtext=fontfile='C\:/Windows/Fonts/arial.ttf':text='OASIS kernel\: Rust, ~5 500 LoC, 130 unit tests passing':fontsize=26:fontcolor=#666666:x=(w-text_w)/2:y=760[seg4];[5:v]drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='No cloud.  No broker.  No infrastructure.':fontsize=58:fontcolor=#00ff88:x=(w-text_w)/2:y=300,drawtext=fontfile='C\:/Windows/Fonts/arialbd.ttf':text='Devices communicate, adapt, survive sensor loss.':fontsize=46:fontcolor=white:x=(w-text_w)/2:y=420,drawtext=fontfile='C\:/Windows/Fonts/arial.ttf':text='Full detail\: DEMO-MESH-3PLATFORMS.md':fontsize=34:fontcolor=#aaaaaa:x=(w-text_w)/2:y=620,drawtext=fontfile='C\:/Windows/Fonts/arial.ttf':text='souhaybrharrab@gmail.com':fontsize=34:fontcolor=#aaaaaa:x=(w-text_w)/2:y=700,fade=in:0:6[outro];[intro][arch][seg2][graph][seg4][outro]concat=n=6:v=1:a=0[final]
